generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Program {
  id        String   @id @default(cuid())
  name      String
  host      String?
  description String?
  // ── LEGACY: los horarios viven ahora en Schedule (multi-horario).
  // Se conservan con default para no destruir datos de producción.
  // La migración runtime copia estos valores a Schedule una sola vez.
  dayOfWeek Int      @default(0) // 0=Dom, 1=Lun, ..., 6=Sab (LEGACY)
  startTime String   @default("") // LEGACY "06:00"
  endTime   String   @default("") // LEGACY "08:00"
  schedulesMigrated Boolean @default(false) // marca de respaldo a Schedule
  isActive  Boolean  @default(true)
  imageUrl  String?  // 1:1 logo para programación
  playerImageUrl String? // horizontal para reproductor en vivo
  genre     String?
  sortOrder Int      @default(0)
  schedules Schedule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Schedule {
  id          String  @id @default(cuid())
  programId   String
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayOfWeek   Int     // 0=Dom, 1=Lun, ..., 6=Sab
  startTime   String  // "06:00"
  durationMin Int     @default(60) // duración configurable en minutos
  isRerun     Boolean @default(false) // true = reemisión del programa
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([programId])
  @@index([dayOfWeek, startTime])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  type      String   @default("info") // info, alert, promotion
  imageUrl  String?
  isActive  Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AdminLog {
  id        String   @id @default(cuid())
  action    String
  detail    String?
  createdAt DateTime @default(now())
}

model Video {
  id        String   @id @default(cuid())
  title     String
  youtubeUrl String   // full YouTube URL or video ID
  description String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SongRequest {
  id        String   @id @default(cuid())
  listenerName String?
  message   String
  type      String   @default("request") // request, greeting, message
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Device {
  id          String   @id @default(cuid())
  deviceId    String   @unique
  platform    String?  // "android", "ios", "windows", "macos", "linux", "other"
  userAgent   String?
  lastSeenAt  DateTime @default(now())
  installedAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  keysAuth  String
  keysP256dh String
  createdAt DateTime @default(now())
}